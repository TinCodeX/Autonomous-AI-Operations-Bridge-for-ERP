@"
# Odoo 18 Connection
ODOO_URL=http://web:8069
ODOO_DB=odoo
ODOO_USERNAME=your_username
ODOO_PASSWORD=your_odoo_password_or_api_key

# Telegram Bot & Security Whitelist
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ALLOWED_TELEGRAM_USERS=123456789

# Groq LLM Engine
GROQ_API_KEY=your_groq_api_key
LLM_MODEL=openai/gpt-oss-120b

# Autonomous Inventory Watchdog
STOCK_CHECK_INTERVAL=1800

# Gmail MCP (SMTP / IMAP via Google App Password)
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
"@ | Set-Content -Path odoo-mcp-server\.env.example -Encoding UTF8